{
  "uid": "llm-serving",
  "title": "LLM serving: latência, tokens e custo",
  "tags": [
    "llm",
    "istio",
    "cost"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "15s",
