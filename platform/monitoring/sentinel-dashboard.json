      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Taxa de erro 5xx",
      "description": "Falhas de plataforma (evicção, sidecar) aparecem aqui, não na latência (D-10).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(istio_requests_total{reporter=\"source\", destination_service_name=\"llm\", request_path=\"/v1/chat/completions\", response_code=~\"5..\"}[60s])) / clamp_min(sum(rate(istio_requests_total{reporter=\"source\", destination_service_name=\"llm\", request_path=\"/v1/chat/completions\"}[60s])), 1e-9)",
          "legendFormat": "l1_err_rate",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 8,
