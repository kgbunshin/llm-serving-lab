{
  "uid": "slo-sentinel-cpu",
  "title": "slo-sentinel · campanha (cpu)",
  "description": "Gerado por `sentinel dashboard` a partir de experiments/signals.yaml. Não editar à mão.",
  "tags": [
    "slo-sentinel",
    "cpu"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "L",
        "label": "Limiar L (s)",
        "type": "textbox",
        "query": "22.76",
        "current": {
          "text": "22.76",
          "value": "22.76"
        },
        "description": "2× o p95 sem carga (characterization). O burn rate usa o bucket de 30000 ms do Istio, fixado na geração (D-15)."
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "name": "Falhas",
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "iconColor": "red",
        "target": {
          "type": "tags",
          "tags": [
            "slo-sentinel",
            "fault-window"
          ],
          "matchAny": false,
          "limit": 500
        }
      },
      {
        "name": "Episódios",
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": false,
        "iconColor": "rgba(128, 128, 128, 0.4)",
        "target": {
          "type": "tags",
          "tags": [
            "slo-sentinel",
            "episode-window"
          ],
          "matchAny": false,
          "limit": 500
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "SLO",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "p95 de latência vs. limiar L",
      "description": "A série em que o SLO é avaliado (janela do SLO). Violação = acima de L em 2 avaliações seguidas. As faixas vermelhas são falhas injetadas pelo runner.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(istio_request_duration_milliseconds_bucket{reporter=\"source\", destination_service_name=\"llm\", request_path=\"/v1/chat/completions\", response_code=\"200\"}[300s]))) / 1000",
          "legendFormat": "p95",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "$L",
          "legendFormat": "L (limiar)",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "L (limiar)"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Burn rate (D1)",
      "description": "Fração de requisições ruins ÷ (1 − objetivo). D1 alarma com 14,4× na janela de 5m (e na curta) ou 6× na de 30m.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "((sum(rate(istio_requests_total{reporter=\"source\", destination_service_name=\"llm\", request_path=\"/v1/chat/completions\"}[300s])) - sum(rate(istio_request_duration_milliseconds_bucket{reporter=\"source\", destination_service_name=\"llm\", request_path=\"/v1/chat/completions\", response_code=\"200\", le=\"30000\"}[300s]))) * 5) / clamp_min(sum(rate(istio_requests_total{reporter=\"source\", destination_service_name=\"llm\", request_path=\"/v1/chat/completions\"}[300s])) * 5, 1e-9) / 0.01",
          "legendFormat": "burn 5m",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "((sum(rate(istio_requests_total{reporter=\"source\", destination_service_name=\"llm\", request_path=\"/v1/chat/completions\"}[1800s])) - sum(rate(istio_request_duration_milliseconds_bucket{reporter=\"source\", destination_service_name=\"llm\", request_path=\"/v1/chat/completions\", response_code=\"200\", le=\"30000\"}[1800s]))) * 5) / clamp_min(sum(rate(istio_requests_total{reporter=\"source\", destination_service_name=\"llm\", request_path=\"/v1/chat/completions\"}[1800s])) * 5, 1e-9) / 0.01",
          "legendFormat": "burn 30m",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 4,
      "type": "row",
      "title": "L1 · mesh (Istio, gateway)",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Latência",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.50, sum by (le) (rate(istio_request_duration_milliseconds_bucket{reporter=\"source\", destination_service_name=\"llm\", request_path=\"/v1/chat/completions\", response_code=\"200\"}[300s]))) / 1000",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(istio_request_duration_milliseconds_bucket{reporter=\"source\", destination_service_name=\"llm\", request_path=\"/v1/chat/completions\", response_code=\"200\"}[300s]))) / 1000",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(istio_request_duration_milliseconds_bucket{reporter=\"source\", destination_service_name=\"llm\", request_path=\"/v1/chat/completions\", response_code=\"200\"}[300s]))) / 1000",
          "legendFormat": "p99",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Requisições/s",
