# Managed by Ansible. The VPS has no firewall and k3s opens ports on 0.0.0.0.
# This table drops all cluster traffic on the public interface. It sits in
# prerouting, before kube-proxy DNAT, so it covers NodePorts too.
# Its own table: doesn't use nftables.service, whose "flush ruleset" would
# wipe out the k3s rules.
table inet llmlab_guard
delete table inet llmlab_guard
table inet llmlab_guard {
  chain prerouting {
    type filter hook prerouting priority -150; policy accept;
    iifname "{{ public_iface }}" tcp dport { 2379-2380, 6443, 10250, 30000-32767 } drop
    iifname "{{ public_iface }}" udp dport { 8472, 51820-51821, 30000-32767 } drop
  }
}
