# Managed by Ansible (llm-serving-lab/infra/vps/k3s.yml).
write-kubeconfig-mode: "0600"
disable:
  - traefik        # Istio is the ingress
  - servicelb      # nothing becomes a public LoadBalancer
tls-san:
  - 127.0.0.1      # access only through an SSH tunnel
secrets-encryption: true
kubelet-arg:
  # Reserved for Delfos, cloudflared and the system, which share the machine.
  - system-reserved=cpu=500m,memory=1536Mi
  - eviction-hard=memory.available<500Mi
